# Preenchido no Passo 2 (banco de dados) e Passo 3 (API do Claude).
# Copie este arquivo para ".env" e preencha os valores reais — o ".env" nunca vai pro repositório.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SEM prefixo VITE_ de propósito — variáveis com VITE_ ficam visíveis no navegador.
# Esta aqui só é lida pela função-servidor (api/claude.js), nunca pelo app em si.
ANTHROPIC_API_KEY=
